# Copy this file to ".env" and fill in your values.
# NEVER share the .env file or your token with anyone.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your application/client id (General Information tab in the dev portal)
CLIENT_ID=your-application-id-here

# The id of the server (guild) this private bot runs in.
# Right-click your server > Copy Server ID (enable Developer Mode first).
GUILD_ID=your-guild-id-here

# Optional: comma separated ids of extra guilds to register commands in.
# Usually you only need GUILD_ID.
EXTRA_GUILD_IDS=
