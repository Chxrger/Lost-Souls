# Copy this file to ".env" and fill in your values.
# NEVER share the .env file or your token with anyone.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your application/client id (General Information tab in the dev portal)
CLIENT_ID=your-application-id-here

# The id of the server (guild) this private bot runs in.
# Right-click your server > Copy Server ID (enable Developer Mode first).
GUILD_ID=your-guild-id-here

# Optional: comma separated ids of extra guilds to register commands in.
# Usually you only need GUILD_ID.
EXTRA_GUILD_IDS=

# Optional: log verbosity (debug, info, warn, error). Use "debug" to see the
# full discord-player pipeline when diagnosing playback problems.
LOG_LEVEL=info

# Optional: a YouTube cookie string. Useful when the bot is hosted on a
# datacenter/VPS IP that YouTube blocks ("confirm you're not a bot"). Paste the
# Cookie header from a logged-in youtube.com request. Treat it like a password.
YOUTUBE_COOKIE=

# Optional: set to "true" to skip the YouTube "player" JS fetch.
YOUTUBE_DISABLE_PLAYER=false

# Optional: an HTTP proxy for YouTube requests, e.g. http://user:pass@host:port
# The most reliable fix when hosted on a datacenter IP that YouTube blocks.
# A residential proxy works best.
YOUTUBE_PROXY=
